#!/usr/bin/expect -f

set timeout -1
set reviewer_opened 0
set cache_dir "/Users/christopher/Library/Caches/noise-safety-reviewer"
set url_file "$cache_dir/private-url"
set sync_script "/Users/christopher/Dev/noise/noiseSaftey/sync-production.sh"
set production_root "/Users/christopher/Library/Application Support/noise/safety-production"
set production_secret "$production_root/recipient-secret.json"
set production_inbox "$production_root/inbox"
set production_state "$production_root/review-state"

file mkdir $cache_dir
file attributes $cache_dir -permissions 0700

set listener_pid ""
catch {
    set listener_pid [string trim [
        exec /usr/sbin/lsof -tiTCP:4311 -sTCP:LISTEN
    ]]
}

if {$listener_pid ne ""} {
    set listener_command ""
    catch {
        set listener_command [string trim [
            exec /bin/ps -p $listener_pid -o comm=
        ]]
    }
    if {![string match "*noise-safety-intake" $listener_command]} {
        puts "Port 4311 is being used by another application."
        puts "The noise safety reviewer was not started."
        exit 1
    }
    if {[file exists $url_file]} {
        set saved_url_file [open $url_file r]
        set saved_url [string trim [read $saved_url_file]]
        close $saved_url_file
        if {[string match "http://127.0.0.1:4311/*" $saved_url]} {
            puts "noise safety reviewer is already running"
            puts "opening its private URL"
            exec open $saved_url &
            exit 0
        }
    }

    # A reviewer started before this launcher learned to remember its private
    # URL cannot be reopened. Stop only that known reviewer process and replace
    # it with a fresh localhost session.
    exec /bin/kill $listener_pid
    for {set attempt 0} {$attempt < 30} {incr attempt} {
        after 100
        set still_listening ""
        catch {
            set still_listening [string trim [
                exec /usr/sbin/lsof -tiTCP:4311 -sTCP:LISTEN
            ]]
        }
        if {$still_listening eq ""} {
            break
        }
    }
}

if {[file exists $url_file]} {
    file delete $url_file
}

set initial_sync_output ""
if {[catch {exec $sync_script} initial_sync_output]} {
    puts "Could not sync the production safety inbox."
    puts $initial_sync_output
    exit 1
}
if {$initial_sync_output ne ""} {
    puts $initial_sync_output
}

proc sync_production {sync_script} {
    set sync_output ""
    if {[catch {exec $sync_script} sync_output]} {
        puts "Production safety sync failed; it will retry."
        puts $sync_output
    } elseif {$sync_output ne ""} {
        puts $sync_output
    }
    after 10000 [list sync_production $sync_script]
}
after 10000 [list sync_production $sync_script]

cd "/Users/christopher/Dev/noise"
spawn -noecho cargo run -q -p noise-safety-intake -- review \
    --secret-key-file "$production_secret" \
    --spool-dir "$production_inbox" \
    --state-dir "$production_state"

expect {
    -re {open this private URL: (http://127\.0\.0\.1:4311/[^\r\n ]+)} {
        if {$reviewer_opened == 0} {
            set reviewer_opened 1
            set review_url $expect_out(1,string)
            set private_url_file [open $url_file w]
            puts -nonewline $private_url_file $review_url
            close $private_url_file
            file attributes $url_file -permissions 0600
            exec open $review_url &
        }
        exp_continue
    }
    eof {
        if {[file exists $url_file]} {
            file delete $url_file
        }
    }
}
