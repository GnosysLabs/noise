[Unit]
Description=noise central compatibility and canonical API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=noise-central
Group=noise-central
WorkingDirectory=/var/lib/noise-central
EnvironmentFile=/etc/noise-central/environment
ExecStart=/opt/noise-central/current/noise-central --listen 127.0.0.1:4302
Restart=on-failure
RestartSec=2s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
